<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Limits only, every 15 minutes. Reads one key out of ~/.claude.json,
  re-archives the tail of the desktop app's rolling series, and makes one
  authenticated GET to /api/oauth/usage when the last one is over 15 minutes
  old.

  That last part is the only scheduled network call in the tool, and it is here
  rather than in the hourly agent for a reason: weekly_scoped -- the limit that
  actually binds -- exists in no local file, and once an hour is too coarse to
  be a series. A 3-minute floor in src/limits.ts applies regardless of how
  often this fires; set CUSAGE_REFRESH=off below to make the agent purely
  local again.

  Separate from the hourly agent because the two jobs have wildly different
  costs: one walks 240 MB, the other reads a cached JSON blob. Hourly is right
  for the first and far too coarse for the second -- sampling a five-hour
  window once an hour is worse resolution than the desktop series this is
  archiving in the first place.

  Rendered from this template by scripts/install-agents.sh; {{REPO}} and
  {{HOME}} are substituted there. Do not install this file directly.

  bun is invoked by absolute path on purpose. node lives behind an fnm
  multishell path that changes every shell, which launchd does not have.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.logan.claude-usage-limits</string>

  <key>ProgramArguments</key>
  <array>
    <string>{{HOME}}/.bun/bin/bun</string>
    <string>run</string>
    <string>{{REPO}}/src/cli.ts</string>
    <string>sync</string>
    <string>--limits-only</string>
  </array>

  <key>WorkingDirectory</key>
  <string>{{REPO}}</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>{{HOME}}</string>
    <key>PATH</key>
    <string>{{HOME}}/.bun/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>StartInterval</key>
  <integer>900</integer>

  <key>RunAtLoad</key>
  <true/>

  <!-- Nothing here is urgent and the first run reads 240 MB. Stay out of the
       way of whatever is actually using the machine. -->
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>Nice</key>
  <integer>5</integer>

  <key>StandardOutPath</key>
  <string>{{HOME}}/Library/Logs/claude-usage/limits.log</string>
  <key>StandardErrorPath</key>
  <string>{{HOME}}/Library/Logs/claude-usage/limits.log</string>
</dict>
</plist>
