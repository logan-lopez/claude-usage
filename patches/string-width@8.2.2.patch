+// cusage patch: memoize per-cluster widths. The Unicode property regexes below
+// (especially /^\p{RGI_Emoji}$/v) are very slow under JavaScriptCore, and Ink
+// measures every text node on every frame. A cluster's width depends only on
+// the cluster and the ambiguous-width option, so the result is identical.
+const clusterWidthCache = [new Map(), new Map()];
+const CLUSTER_CACHE_LIMIT = 4096;
+
+function clusterWidth(segment, eastAsianWidthOptions) {
+	// Zero-width / non-printing clusters
+	if (isZeroWidthCluster(segment)) {
+		return 0;
+	}
+
+	// Emoji width logic
+	if (rgiEmojiRegex.test(segment) || isDoubleWidthNonRgiEmojiSequence(segment)) {
+		return 2;
+	}
+
+	const visibleSegment = baseVisible(segment);
+	const hangulWidth = hangulClusterWidth(visibleSegment, eastAsianWidthOptions);
+	if (hangulWidth !== undefined) {
+		return hangulWidth;
+	}
+
+	// Everything else: EAW of the cluster’s first visible scalar
+	const codePoint = visibleSegment.codePointAt(0);
+	// Add width for trailing spacing marks and Halfwidth/Fullwidth Forms (e.g., ﾞ, ﾟ, ｰ)
+	return eastAsianWidth(codePoint, eastAsianWidthOptions) + trailingWidth(visibleSegment, eastAsianWidthOptions);
+}
